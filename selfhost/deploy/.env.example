# 复制为 /opt/dsh-remote-server/.env 后修改密码。
# 账号建议使用邮箱格式，以兼容现有客户端。
DSH_SERVER_ACCOUNT=owner@example.com
DSH_SERVER_PASSWORD=REPLACE_WITH_YOUR_OWN_PASSWORD

# 后端只监听回环，由 nginx 反代对外。
DSH_SERVER_HOST=127.0.0.1
DSH_SERVER_PORT=18080

# 必须与浏览器实际访问的 origin 完全一致（含协议、主机、端口）。
DSH_SERVER_PUBLIC_URL=https://YOUR_PUBLIC_IP_OR_DOMAIN:8445
DSH_SERVER_DATA_FILE=/opt/dsh-remote-server/data/state.json
DSH_SERVER_LOG_LEVEL=info
DSH_SERVER_HELLO_TIMEOUT_MS=10000

# 可选：WebRTC LAN / P2P / TURN。留空则走端到端加密 Relay。
# DSH_SERVER_STUN_URLS=
# DSH_SERVER_TURN_URLS=
# DSH_SERVER_TURN_SECRET=
# DSH_SERVER_TRUSTED_PROXY_IPS=
